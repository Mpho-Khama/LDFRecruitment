@model CreateOfficerViewModel
@{ ViewData["Title"] = "Add staff account"; }
<div class="container py-4">
    <div class="row justify-content-center"><div class="col-md-6">
        <h1 class="h3 mb-3">Add staff account</h1>
        <form asp-action="CreateOfficer" method="post" class="card card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" /><span asp-validation-for="Password" class="text-danger"></span></div>
            <div class="mb-3">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" class="form-select">
                    <option value="@Roles.Officer">Recruitment officer</option>
                    <option value="@Roles.Administrator">Administrator</option>
                </select>
            </div>
            <div class="d-flex gap-2"><button class="btn btn-ldf" type="submit">Create</button><a class="btn btn-outline-secondary" asp-action="Users">Cancel</a></div>
        </form>
    </div></div>
</div>
